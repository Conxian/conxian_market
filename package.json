{
  "name": "@conxian/market-sdk",
  "version": "0.2.4",
  "description": "Conxian Market SDK — full integration bridge: fee calculator, gateway client, verification, settlement, and SDK capability wiring across the enclave-sdk + lib-conxian-core modules.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "conxian-agent-init": "./bin/conxian-agent-init.mjs"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run && npm run test:cli",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "verify:dist": "npm run build && node scripts/verify-dist.mjs",
    "test:cli": "npm run build && node --test scripts/tests/cli-conformance.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scure/bip39": "^2.4.0",
    "@stacks/clarinet-sdk": "^4.0.0",
    "@stacks/transactions": "^7.7.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "conxian",
    "protocol-fee",
    "settlement",
    "trust-tier",
    "bitcoin",
    "gateway",
    "sdk-bridge",
    "verification",
    "enclave"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.12",
    "vite": "8.3.3"
  }
}
